curl '{{baseUrl}}/dx/api/application/v2/ai-agents/SupportManagement__ProcessTicket/conversations' \
  -H 'accept: application/json, text/plain, */*' \
  -H 'accept-language: en-US,en;q=0.9' \
  -H 'content-type: application/x-www-form-urlencoded' \
  --data-raw '{"contextID":{{caseID}},"executeStarterQuestion":false}'