curl '{{baseUrl}}/dx/api/application/v2/ai-agents/SupportManagement__ProcessTicket/conversations/{{conversationID}}' \
  -X 'PATCH' \
  -H 'accept: application/json, text/plain, */*' \
  -H 'accept-language: en-US,en;q=0.9' \
  -H 'content-type: application/x-www-form-urlencoded' \
  --data-raw '{"request":"When is the case created","capabilities":{"tools":{"isManualConfirmationSupported":true}}}'