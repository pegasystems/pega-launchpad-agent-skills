curl '{{baseUrl}}/dx/api/application/v2/attachments/upload' \
  -H 'accept: application/json, text/plain, */*' \
  -H 'accept-language: en-US,en;q=0.9' \
  -H 'content-type: multipart/form-data; boundary=----WebKitFormBoundaryWbb6mMuC3MJULBSe' \
  --data-raw $'------WebKitFormBoundaryWbb6mMuC3MJULBSe\r\nContent-Disposition: form-data; name="appendUniqueIdToFileName"\r\n\r\ntrue\r\n------WebKitFormBoundaryWbb6mMuC3MJULBSe\r\nContent-Disposition: form-data; name="file"; filename="genai.svg"\r\nContent-Type: image/svg+xml\r\n\r\n\r\n------WebKitFormBoundaryWbb6mMuC3MJULBSe\r\nContent-Disposition: form-data; name="contextID"\r\n\r\{{caseID}}\r\n------WebKitFormBoundaryWbb6mMuC3MJULBSe--\r\n'