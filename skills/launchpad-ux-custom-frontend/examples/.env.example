# ----------------------------------------------------------------------------
# Launchpad DX API – environment variables
# Copy this file to ".env" and fill in the values for your environment.
# Never commit the populated ".env" file – only this ".env.example" template.
# ----------------------------------------------------------------------------

# Base URL of the Launchpad application (used to invoke the DX APIs)
LAUNCHPAD_BASE_URL=https://<appURL>

# OAuth 2.0 token endpoint (Access Token URL) – used to obtain an access token
LAUNCHPAD_TOKEN_URL=https://<tokenURL>/oauth2/token

# OAuth 2.0 authorize endpoint – used by the PKCE interactive login flow
LAUNCHPAD_AUTH_URL=https://<tokenURL>/oauth2/authorize

# Client Registration credentials (created in the Launchpad Subscriber environment)
LAUNCHPAD_CLIENT_ID=your-client-id

# Client secret – only required for the "client_credentials" grant.
# Leave blank for PKCE public clients (they use a code verifier/challenge instead).
LAUNCHPAD_CLIENT_SECRET=

# Grant type:
#   pkce               -> interactive user login (default, used most of the time)
#   client_credentials -> system-to-system / no interactive user
LAUNCHPAD_GRANT_TYPE=pkce

# Redirect URI registered for the PKCE flow
LAUNCHPAD_REDIRECT_URI=http://localhost:3000/callback
